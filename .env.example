# ============================================
# Production Forecast — Variables de Entorno
# ============================================
# Copia este archivo como .env y llena los valores.

# --- SAP B1 (SQL Server via ODBC) ---
SAP_DSN=SAPB1
SAP_DB_SERVER=
SAP_DB_NAME=
SAP_DB_USER=
SAP_DB_PASSWORD=
# Usar DSN preconfigurado (true) o conexión directa (false)
SAP_USE_DSN=true

# --- SMTP (Correos de alerta) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Forecast de Producción
SMTP_FROM_EMAIL=

# --- Aplicación ---
APP_PORT=8000
APP_ENV=development
# SECRET_KEY para sesiones (generar con: python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=change-me-in-production

# --- Forecast Config ---
FORECAST_LOOKBACK_DAYS=28
FORECAST_TARGET_STOCK_DAYS=15
FORECAST_SCHEDULE_DAY=wednesday
